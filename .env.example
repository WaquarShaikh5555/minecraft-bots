# ──────────────────────────────────────────────────────────────────────────────
#  Minecraft bot
# ──────────────────────────────────────────────────────────────────────────────

# The bot's in-game name (max 16 chars, A-Z a-z 0-9 _ ).
MC_USERNAME=waquar5555

# One or more servers the bot may join, comma separated (host[:port]).
# The FIRST entry is the one used on boot; the web UI can switch between them.
MC_SERVERS=world.arterex.me:25565

# "offline"  -> cracked / offline-mode servers (online-mode=false). No account needed.
# "microsoft"-> real premium account. Run `npm run login:microsoft` ONCE first.
MC_AUTH=offline

# Leave blank to auto-detect the server version (recommended).
# Only set this if auto-detect fails, e.g. 1.20.4 / 1.21.1
MC_VERSION=

# Premium account joining a CRACKED (online-mode=false) server must skip session
# validation. Ignored when MC_AUTH=offline.
MC_SKIP_VALIDATION=true

# Optional: regex for servers with custom chat prefixes.
# Group 1 = author, group 2 = message. Example for "[VIP] Waquar5555 » hello":
#   CHAT_AUTHOR_PATTERN=^(?:\[[^\]]+\]\s*)?(\w{3,16})\s*»\s*(.*)$
CHAT_AUTHOR_PATTERN=

# Chat the bot sends on join (optional, blank = stay quiet).
# Multiple messages can be separated with a pipe: "Hello!|/list"
MC_JOIN_MESSAGE=

# How the bot behaves. All optional.
MC_VIEW_DISTANCE=6
MC_HIDE_ERRORS=true
MC_RESPAWN=true

# ──────────────────────────────────────────────────────────────────────────────
#  Reconnection
# ──────────────────────────────────────────────────────────────────────────────
RECONNECT=true
RECONNECT_DELAY_MS=5000
RECONNECT_MAX_DELAY_MS=60000
# 0 = retry forever
RECONNECT_MAX_ATTEMPTS=0

# ──────────────────────────────────────────────────────────────────────────────
#  Web dashboard / chat bridge
# ──────────────────────────────────────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0

# Password for talking through the site. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Anyone holding this token can chat on your server as the bot, so keep it secret.
CHAT_TOKEN=change-me-please

# Set to "true" to let visitors chat WITHOUT the token (public, risky).
ALLOW_ANONYMOUS_CHAT=false

# Set to "true" to let visitors switch the bot to another server from the site.
ALLOW_SERVER_SWITCH=false

# Browsers allowed to connect, comma separated (used when the site is hosted
# somewhere else, e.g. GitHub Pages). Blank = same-origin only.
#   ALLOWED_ORIGINS=https://waquar5555.github.io,https://bot.arterex.me
ALLOWED_ORIGINS=

# Number of messages kept in memory and replayed to new visitors.
CHAT_HISTORY=400

# Append every line to a JSONL log file. "false" to disable.
CHAT_LOG_FILE=data/chat.jsonl

# Show action-bar / title spam in the feed (health bars, boss timers, ...).
SHOW_ACTION_BAR=false

# Minimum milliseconds between two messages sent by the bot (anti-kick).
SEND_COOLDOWN_MS=800
# Max messages a single visitor may send per window.
RATE_LIMIT_MESSAGES=8
RATE_LIMIT_WINDOW_MS=10000

# ──────────────────────────────────────────────────────────────────────────────
#  Misc
# ──────────────────────────────────────────────────────────────────────────────
# Ping the server for its MOTD / player counts to show in the UI.
PING_SERVER=true
LOG_LEVEL=info

# Set to "true" to run ONLY the web dashboard (no Minecraft connection).
# Handy while you are working on the site. Same as `npm run web`.
NO_BOT=false
