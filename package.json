{
  "name": "minecraft-bots",
  "version": "1.0.0",
  "description": "Headless Minecraft Java bot (Mineflayer) with a live web chat bridge — watch and talk to the server from any browser.",
  "main": "src/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "web": "node src/index.js --no-bot",
    "login:microsoft": "node src/microsoft-login.js",
    "test": "node --test test/*.test.js",
    "diagnose": "node scripts/diagnose.js",
    "diagnose:login": "node scripts/diagnose.js --login"
  },
  "keywords": [
    "minecraft",
    "mineflayer",
    "bot",
    "chat",
    "websocket",
    "offline-mode"
  ],
  "author": "Waquar Shaikh",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "mineflayer": "^4.39.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "jsdom": "^30.1.2"
  }
}
